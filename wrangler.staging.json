{
 "name": "family-day-game-staging",
 "main": "apps/worker/src/index.ts",
 "compatibility_date": "2026-10-01",
 "workers_dev": true,
 "preview_urls": false,
 "assets": {"directory": "apps/web/build", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true},
 "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "GameRoom"}, {"name": "DIRECTORY", "class_name": "RoomDirectory"}]},
 "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameRoom"]}, {"tag": "v2", "new_sqlite_classes": ["RoomDirectory"]}],
 "d1_databases": [{"binding": "DB", "database_name": "family-day-game-staging", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "migrations"}],
 "vars": {"DEPLOYMENT_ENV": "staging", "PUBLIC_DEPLOYMENT": "true", "TURNSTILE_MODE": "test", "STAGING_HOSTNAME": "NOT-CONFIGURED", "TURNSTILE_SITE_KEY": "1x00000000000000000000AA", "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA"}
}
