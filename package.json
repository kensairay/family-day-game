{
  "name": "family-day-game",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @family/web",
    "dev": "npm run build && npm run db:migrate:local && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply family-day-game --local",
    "check": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/worker",
    "test": "npm run test:unit && npm run test:game && npm run test:admin && npm run test:results",
    "test:unit": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:game": "node tests/integration/game.local.mjs",
    "test:admin": "node tests/integration/admin.local.mjs",
    "test:results": "node --experimental-strip-types tests/integration/results.local.mjs",
    "test:lobby": "node tests/integration/lobby.http.cjs",
    "test:browser": "node tests/integration/lobby.e2e.cjs",
    "test:admin:browser": "npm run build && node tests/integration/admin.browser.local.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261001.0-alpha",
    "playwright": "^1.63.0",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest",
    "ws": "^8.22.0"
  }
}
